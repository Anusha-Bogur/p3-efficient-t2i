flowchart TB
  subgraph APP["1. Gradio app on Hugging Face Space (app/app.py)"]
    IN["Prompt + seed + CV on/off"] --> VAL["Input validation: empty rejected, >77 tokens warned"]
  end
  subgraph GEN["2. Generation (models/pipeline.py, config bk_final, fp16)"]
    TE["CLIP ViT-L/14 text encoder"] --> UNET["BK-SDM-Small-2M UNet + LoRA (fused)"]
