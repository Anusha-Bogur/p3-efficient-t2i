  subgraph OFF["5. Offline"]
    TR["LoRA training (train/lora.sh): 1,000 COCO train pairs"] 
    EV["Evaluation (eval/run_eval.py): 6 configs x 300 COCO val prompts"]
  end
  TR -. "lora_bk/" .-> UNET
